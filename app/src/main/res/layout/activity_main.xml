<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <FrameLayout
            android:id="@+id/tabsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pestañas">

            <TextView
                android:id="@+id/tabsCount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/tab_counter"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/url_bg"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/ublockButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="uBlock Origin">

            <ImageView
                android:id="@+id/ublockIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/ublockBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menú"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="invisible" />

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
